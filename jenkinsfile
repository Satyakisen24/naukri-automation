
pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    triggers {
        cron('0 9 * * *')
    }

    stages {
        stage('Check Python') {
            steps {
                bat '''
                    cd /d D:\\naukri-automation
                    py -3 --version
                '''
            }
        }

        stage('Check Project Files') {
            steps {
                bat '''
                    cd /d D:\\naukri-automation

                    if not exist config.json exit /b 1
                    if not exist scripts\\update_naukri.py exit /b 1
                    if not exist requirements.txt exit /b 1
                    if not exist resume\\Satyaki_resume.pdf exit /b 1
                    if not exist chrome-profile mkdir chrome-profile
                '''
            }
        }

        stage('Install Dependencies') {
            steps {
                bat '''
                    cd /d D:\\naukri-automation
                    py -3 -m pip install -r requirements.txt
                '''
            }
        }

        stage('Inspect Naukri Automation') {
            steps {
                bat '''
                    cd /d D:\\naukri-automation
                    py -3 scripts\\update_naukri.py
                    if errorlevel 1 exit /b 1
                '''
            }
        }
    }

    post {
        always {
            archiveArtifacts(
                artifacts: 'D:/naukri-automation/logs/**',
                allowEmptyArchive: true
            )

            echo 'Review the archived logs and screenshots. If login or confirmation is required, complete it manually.'
        }
    }
}
